PERF_KEY_DEF(RC_BATCH_GET_INTO_MULTI_INTERNAL,  "real_client.cpp::batch_get_into_multi_buffers_internal","BatchGetIntoMultiBufInternal")
PERF_KEY_DEF(RC_BATCH_GET_REPLICA_DESC,         "real_client.cpp::batch_get_replica_desc",   "BatchGetReplicaDesc")

// === Client 服务层（vllm 路径下沉，部分已有打点）===
PERF_KEY_DEF(CLIENT_BATCH_QUERY,                "client_service.cpp::BatchQuery",            "BatchQuery")

// === CVM 路由（多 submaster，读写共键）===
// RouteSwitch status: 0=hit 切换 / 2=miss 失败；表空(单master)不激活
PERF_KEY_DEF(CVM_ROUTE_SWITCH,        "master_client.cpp::SwitchToSubmaster",         "RouteSwitch")
// --- BatchQuery 客户端巨尾归因三段（定位 ~4s 尾延迟）---
// RouteRefresh: SLOT_NOT_OWNED 重试分支的 TryLoadRoutingOnce 整窗（etcd 路由
//               全表重载）。正常 0 tick；若出现且 avg 达秒级，巨尾源于路由刷新。
// RpcSend:      invoke_batch_rpc 连接池取用（含首连/重连）+ 请求提交。
//               所有 batch RPC 共用此点；巨尾若落在此段即连接建立/重建问题。
// ResultGet:    invoke_batch_rpc 等待响应（网络 RTT + 服务端 handler 整窗）。
//               RouteRefresh(若触发)+RpcSend+ResultGet 之和 ≈ BatchQuery 总时长。
PERF_KEY_DEF(CVM_BATCH_QUERY_ROUTE_REFRESH, "client_service.cpp::BatchQuery",      "RouteRefresh")
PERF_KEY_DEF(CVM_RPC_BATCH_SEND,           "master_client.cpp::invoke_batch_rpc", "RpcSend")
PERF_KEY_DEF(CVM_RPC_BATCH_RESULT_GET,    "master_client.cpp::invoke_batch_rpc", "ResultGet")
// RouteGroup: GroupKeysBySubmaster 整窗（每批 16 key 的 slot→owner 分组 + 描述
//             日志构建）。BatchQuery − RouteRefresh − RpcSend − ResultGet 的残差段。
//             status: 0=全部命中 / 2=存在无 owner 的 key（与 RouteSwitch miss=2 对齐）
PERF_KEY_DEF(CVM_RPC_BATCH_ROUTE_GROUP,    "master_client.cpp::GroupKeysBySubmaster", "RouteGroup")
// StaleRouteRetry: SLOT_NOT_OWNED/STALE_ROUTE 重试分支整窗（含同步 etcd 全表重载）
PERF_KEY_DEF(CVM_ROUTE_STALE_RETRY,   "master_client.cpp::InvokeRoutedWithSlotRetry", "StaleRouteRetry")
// Backoff: SLOT_MIGRATING 退避重试总时长（最多 3 次 20/40/80ms，DEBUG 级）
PERF_KEY_DEF(CVM_ROUTE_BACKOFF,       "master_client.cpp::InvokeRoutedWithSlotRetry", "RouteBackoff")

// === Get 读特有异步尾部 ===
// SsdLeaseExpired: owner 端 pinned buffer 租约超时（OBJECT_HAS_LEASE）计数信号，
// 发生率 = badCount / GET_SSD_OFFLOAD_RPC tickCount
PERF_KEY_DEF(GET_SSD_LEASE_EXPIRED,   "real_client.cpp::batch_get_into_offload_object_internal", "SsdLeaseExpired")
// PromotionEnqueue: 读命中仅 LOCAL_DISK 副本时的 promotion 异步入队（master 侧）
PERF_KEY_DEF(GET_PROMOTION_ENQUEUE,   "master_service.cpp::TryPushPromotionQueue", "PromotionEnqueue")
// === vsegment 读链路（Hard C inline-layout 路径） ===
// LayoutBuild: Master 在原 Query RPC 内从 cache/view 构造响应 layout 表。
// LayoutCopy:  客户端复制或合并响应 layout 表并挂入 QueryResult。
// Plan:   layout 查找/校验、逻辑地址条带拆分和 endpoint 映射。
// Submit: openSegment、TransferRequest 构造和 Transfer Engine 批量提交。
// Wait:   已提交传输的完成等待；覆盖单读、range read 和 BatchGet。
PERF_KEY_DEF(VSEGMENT_READ_LAYOUT_BUILD, "master_service.cpp::vsegment_read", "VSegLayoutBuild")
PERF_KEY_DEF(VSEGMENT_READ_LAYOUT_COPY,  "client_service.cpp::vsegment_read", "VSegLayoutCopy")
PERF_KEY_DEF(VSEGMENT_READ_PLAN,   "client_service.cpp::vsegment_read", "VSegPlan")
PERF_KEY_DEF(VSEGMENT_READ_SUBMIT, "client_service.cpp::vsegment_read", "VSegSubmit")
PERF_KEY_DEF(VSEGMENT_READ_WAIT,   "client_service.cpp::vsegment_read", "VSegWait")
// === Query 路径下钻（GET 路径核心通信段统计） ===
PERF_KEY_DEF(QUERY_ROUTE_SWITCH,  "master_client.cpp::Query",  "QueryRouteSwitch")
PERF_KEY_DEF(QUERY_RPC_CALL,      "master_client.cpp::Query",  "QueryRpcCall")
