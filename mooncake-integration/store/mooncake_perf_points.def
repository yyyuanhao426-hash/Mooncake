// --- RPC 内部子步骤 ---
PERF_KEY_DEF(MASTER_PUT_ALLOCATE_MEM,     "master_service.cpp::AllocateAndInsertMetadata", "AllocateMemory")
PERF_KEY_DEF(MASTER_PUT_ALLOCATE_NOF,     "master_service.cpp::AllocateAndInsertMetadata", "AllocateNoF")
PERF_KEY_DEF(MASTER_PUT_SHARD_LOCK,       "master_service.cpp::PutStart",        "AcquireShardLock")
PERF_KEY_DEF(MASTER_SNAPSHOT_LOCK,        "master_service.cpp::SnapshotThreadFunc", "AcquireSnapshotLock")
// Batch get 服务端归因：锁获取（snapshot_mutex_ 共享锁 + shard 读锁）vs
// 副本构建（逐 key 元数据查找 + 响应组装）。对照 449µs avg / 24.6µs min。
PERF_KEY_DEF(MASTER_GET_SHARD_LOCK,       "master_service.cpp::BatchGetReplicaListLocal", "AcquireShardLock")
PERF_KEY_DEF(MASTER_GET_REPLICA_BUILD,    "master_service.cpp::BatchGetReplicaListLocal", "ReplicaBuild")
// 二轮归因（锁 74ns / 构建 2.5µs 已排除，剩余 ~415µs 在未覆盖段）：
// GroupRoute:    group_routing_mutex_ 路由阶段整窗（16 key 的 MakeScopedKey
//                字符串构造 + object_group_ids_ 哈希查找，每请求 1 tick）。
// RecordAccess:  io_pattern_runtime_->RecordAccess 逐 key 记录（每 shard 访问
//                1 tick，930 特性访问模式统计的潜在重活）。
// HandlerConvert: rpc 层响应转换+序列化整窗（16 个 GetReplicaListResponse →
//                批量响应结构 + struct_pack，每请求 1 tick）。
PERF_KEY_DEF(MASTER_GET_GROUP_ROUTE,      "master_service.cpp::BatchGetReplicaListLocal", "GroupRoute")
PERF_KEY_DEF(MASTER_GET_IO_RECORD,        "master_service.cpp::BatchGetReplicaListLocal", "RecordAccess")
// io_pattern RecordAccess 内部锁分段（query 阻塞点归因）。
// DroppedBefore/After 本征 ~100ns（仅读 dropped_ 计数）：avg 显著偏高 =
//     collector mutex 被后台路径（GetSnapshot/FlushReports/MergeSnapshot）持有。
// CollectorRecord = collector 锁等待 + 临界区（reporter 嵌套锁 + notify_one
//                  + std::function 堆分配 + key_metrics_ 哈希 + windows deque）。
// CollectLatency  = observability mutex，本征极小，偏高即跨 Record* 路径竞争。
// FeedbackUpdate  = feedback_state_mutex_ 临界区；FeedbackRecord 为 64 次访问
//                  触发一次的二次加锁（feedback_.Record + tuner_.Tune 调优）。
PERF_KEY_DEF(MASTER_IO_DROPPED_BEFORE,   "runtime.cpp::RecordAccess", "IoDroppedBefore")
PERF_KEY_DEF(MASTER_IO_COLLECTOR_RECORD, "runtime.cpp::RecordAccess", "IoCollectorRecord")
PERF_KEY_DEF(MASTER_IO_COLLECT_LATENCY,  "runtime.cpp::RecordAccess", "IoCollectLatency")
PERF_KEY_DEF(MASTER_IO_DROPPED_AFTER,    "runtime.cpp::RecordAccess", "IoDroppedAfter")
PERF_KEY_DEF(MASTER_IO_FEEDBACK_UPDATE,  "runtime.cpp::RecordAccess", "IoFeedbackUpdate")
PERF_KEY_DEF(MASTER_IO_FEEDBACK_RECORD,  "runtime.cpp::RecordAccess", "IoFeedbackRecord")
// 单 key GetReplicaListLocal owner 路径归因（与 batch 路径 MASTER_GET_* 分开
// 统计，避免两种路径混在同一 slot）。
// Total:  全函数（含 RecordAccess 与残差：metrics 计数、resp 构造、io_access
//         组装）。Total - Core - MASTER_IO_* 即未覆盖残差。
// Core:   owner 7 段整体：snapshot 读锁 → shard 读锁 → client 读锁 →
//         alive clients 复制 → replica 构建 → lease 刷新 → promotion 入队；
//         早退路径（OBJECT_NOT_FOUND / REPLICA_IS_NOT_READY）同样结束本点。
// SnapLock:   snapshot_mutex_ 共享锁单独计时，偏高 = 写者（快照/挂载）持锁排队。
// ShardLock:  MetadataAccessorRO 构造 = shard 共享锁 + tenant/metadata/
//             processing 三次哈希查找（构造函数无法拆分，比 batch 路径的
//             ShardLock 多含 ~百 ns 级查找开销）。
// ClientLock: client_mutex_ 共享锁单独计时（alive clients 复制前的排队）。
PERF_KEY_DEF(MASTER_GET_LOCAL_TOTAL,       "master_service.cpp::GetReplicaListLocal", "GetLocalTotal")
PERF_KEY_DEF(MASTER_GET_LOCAL_CORE,        "master_service.cpp::GetReplicaListLocal", "GetLocalCore")
PERF_KEY_DEF(MASTER_GET_LOCAL_SNAP_LOCK,   "master_service.cpp::GetReplicaListLocal", "GetLocalSnapLock")
PERF_KEY_DEF(MASTER_GET_LOCAL_SHARD_LOCK,  "master_service.cpp::GetReplicaListLocal", "GetLocalShardLock")
PERF_KEY_DEF(MASTER_GET_LOCAL_CLIENT_LOCK, "master_service.cpp::GetReplicaListLocal", "GetLocalClientLock")
PERF_KEY_DEF(MASTER_RPC_RESP_CONVERT,     "rpc_service.cpp::BatchGetReplicaList", "HandlerConvert")

